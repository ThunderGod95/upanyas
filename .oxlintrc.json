{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "react",
        "nextjs",
        "jsx-a11y",
        "import"
    ],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "env": {
        "browser": true,
        "node": true
    },
    "ignorePatterns": [
        ".next/**",
        "out/**",
        "build/**",
        "coverage/**",
        "prisma/generated/**",
        "components/shadcn/**",
        "next-env.d.ts"
    ],
    "rules": {
        "no-debugger": "error",
        "eqeqeq": ["error", "always"],
        "no-console": "off",
        "react/react-in-jsx-scope": "off",
        "import/no-unassigned-import": [
            "warn",
            {
                "allow": ["server-only", "client-only", "**/*.css"]
            }
        ]
    }
}
