generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id
  name            String
  username        String?  @unique
  displayUsername String?
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  authorProfile     Author?
  translatorProfile Translator?

  chapterDraftEdits ChapterDraft[]    @relation("DraftLastEditor")
  chapterRevisions  ChapterRevision[] @relation("RevisionCreator")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Language {
  ENGLISH
  CHINESE
  KOREAN
  JAPANESE
  HINDI
  UNKNOWN
}

enum SeriesVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum SeriesSerializationStatus {
  UNKNOWN
  NOT_APPLICABLE
  NOT_STARTED
  ONGOING
  HIATUS
  COMPLETED
  DISCONTINUED
}

model Series {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  coverUrl         String?
  shortDescription String?
  longDescription  String

  visibility        SeriesVisibility          @default(PRIVATE)
  originalStatus    SeriesSerializationStatus @default(UNKNOWN)
  translationStatus SeriesSerializationStatus @default(UNKNOWN)

  originalLanguage Language @default(UNKNOWN)
  language         Language @default(UNKNOWN)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authors     SeriesAuthor[]
  translators SeriesTranslator[]

  genres Genre[]
  tags   Tag[]

  volumes  Volume[]
  chapters Chapter[]

  featured FeaturedSeries?

  @@index([originalStatus, translationStatus, visibility, publishedAt(sort: Desc)])
  @@index([createdAt])
  @@map("series")
}

model Author {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  bio  String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  series SeriesAuthor[]

  @@map("author")
}

model SeriesAuthor {
  seriesId String
  authorId String
  position Int    @default(0)

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([seriesId, authorId])
  @@index([authorId])
  @@map("series_author")
}

model Translator {
  id      String  @id @default(cuid())
  penName String?
  bio     String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  series SeriesTranslator[]

  @@map("translator")
}

model SeriesTranslator {
  seriesId     String
  translatorId String
  position     Int    @default(0)

  series     Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  translator Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@id([seriesId, translatorId])
  @@index([translatorId])
  @@map("series_translator")
}

model Genre {
  id   String @id @default(cuid())
  name String
  slug String @unique

  series Series[]

  @@map("genre")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  series Series[]

  @@map("tag")
}

model FeaturedSeries {
  seriesId  String   @id
  position  Int
  createdAt DateTime @default(now())

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([position])
  @@map("featured_series")
}

model Volume {
  id          String   @id @default(cuid())
  seriesId    String
  title       String
  description String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([seriesId, position])
  @@map("volume")
}

model Chapter {
  id               String    @id @default(cuid())
  seriesId         String
  volumeId         String?
  position         Int
  numberLabel      String?
  firstPublishedAt DateTime?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  series Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  volume Volume? @relation(fields: [volumeId], references: [id], onDelete: SetNull)

  draft       ChapterDraft?
  revisions   ChapterRevision[]
  publication ChapterPublication?

  @@unique([seriesId, position])
  @@index([volumeId, position])
  @@map("chapter")
}

model ChapterDraft {
  chapterId      String  @id
  baseRevisionId String?
  title          String
  content        Json
  authorNote     String?
  translatorNote String?
  version        Int     @default(1)

  lastEditedById String?
  updatedAt      DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  baseRevision ChapterRevision? @relation("DraftBaseRevision", fields: [baseRevisionId], references: [id], onDelete: SetNull)

  lastEditedBy User? @relation("DraftLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@map("chapter_draft")
}

model ChapterRevision {
  id             String  @id @default(cuid())
  chapterId      String
  revisionNumber Int
  title          String
  content        Json
  authorNote     String?
  translatorNote String?

  wordCount      Int     @default(0)
  characterCount Int     @default(0)
  changeSummary  String?

  createdById String?
  createdAt   DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdBy User? @relation("RevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  basedDrafts       ChapterDraft[]      @relation("DraftBaseRevision")
  activePublication ChapterPublication?

  @@unique([chapterId, revisionNumber])
  @@index([chapterId, createdAt(sort: Desc)])
  @@map("chapter_revision")
}

model ChapterPublication {
  chapterId   String   @id
  revisionId  String   @unique
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  revision ChapterRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@map("chapter_publication")
}
