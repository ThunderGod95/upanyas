{
    "language_servers": ["oxlint", "oxfmt", "..."],
    "languages": {
        "TSX": {
            "format_on_save": "on",
            "formatter": [
                { "language_server": { "name": "oxfmt" } },
                { "code_action": "source.fixAll.oxc" },
            ],
            "language_servers": [
                "!eslint",
                "!typescript-language-server",
                "...",
            ],
        },
        "TypeScript": {
            "format_on_save": "on",
            "formatter": [
                { "language_server": { "name": "oxfmt" } },
                { "code_action": "source.fixAll.oxc" },
            ],
            "language_servers": [
                "!eslint",
                "!typescript-language-server",
                "...",
            ],
        },
        "JavaScript": {
            "format_on_save": "on",
            "formatter": [
                { "language_server": { "name": "oxfmt" } },
                { "code_action": "source.fixAll.oxc" },
            ],
            "language_servers": [
                "!eslint",
                "!typescript-language-server",
                "...",
            ],
        },
        "CSS": {
            "format_on_save": "on",
            "formatter": [
                { "language_server": { "name": "oxfmt" } },
                { "code_action": "source.fixAll.oxc" },
            ],
            "language_servers": ["!vscode-css-language-server", "..."],
        },
    },
}
