{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "endOfLine": "lf",
    "arrowParens": "always",
    "ignorePatterns": [
        ".next/**",
        "out/**",
        "build/**",
        "coverage/**",
        "prisma/generated/**",
        "next-env.d.ts"
    ],
    "sortImports": {
        "internalPattern": ["@/"],
        "groups": [
            "type-import",
            ["value-builtin", "value-external"],
            ["type-internal", "value-internal"],
            [
                "type-parent",
                "type-sibling",
                "type-index",
                "value-parent",
                "value-sibling",
                "value-index"
            ],
            "unknown"
        ]
    },
    "sortTailwindcss": {
        "stylesheet": "./app/globals.css",
        "functions": ["cn", "clsx", "cva"],
        "preserveWhitespace": true
    },
    "sortPackageJson": true
}
